{
  "schemaVersion": 1,
  "id": "radisconstruct",
  "version": "${version}",
  "name": "Radi's Construct",
  "description": "Incremental Hephaestus port: seven storage metals and cobalt ore with Nether generation. Tools and smeltery are not yet ported.",
  "authors": [
    "Radi4"
  ],
  "contributors": [
    "Slime Knights (original Tinkers Construct)",
    "AlphaMode and Hephaestus contributors (Fabric port)"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.radi.radisconstruct.RadisConstruct"
    ],
    "client": [
      "com.radi.radisconstruct.partbuilder.PartBuilderClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}"
  }
}
