{
  "schemaVersion": 1,
  "id": "radisconstruct",
  "version": "${version}",
  "name": "Radi's Construct",
  "description": "Incremental Hephaestus 26.3 port: metals, tools foundation, and original Smeltery structure, fuel, melting and native molten metal registry. Not yet a fully playable original Smeltery.",
  "authors": [
    "Radi4"
  ],
  "contributors": [
    "Slime Knights (original Tinkers Construct)",
    "AlphaMode and Hephaestus contributors (Fabric port)"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.radi.radisconstruct.RadisConstruct"
    ],
    "client": [
      "slimeknights.tconstruct.fluids.NativeMoltenFluidClient",
      "slimeknights.tconstruct.smeltery.client.NativeSmelteryClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}"
  }
}
