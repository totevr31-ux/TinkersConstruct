{
  "schemaVersion": 1,
  "id": "radisconstruct",
  "version": "${version}",
  "name": "Radi's Construct",
  "description": "Incremental Hephaestus port: cobalt and manyullyn storage blocks, ingots and nuggets. Tools, smeltery and world generation are not yet ported.",
  "authors": [
    "Radi4"
  ],
  "contributors": [
    "Slime Knights (original Tinkers Construct)",
    "AlphaMode and Hephaestus contributors (Fabric port)"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.radi.radisconstruct.RadisConstruct"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_version}"
  }
}
